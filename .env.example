# --- PostgreSQL (используется docker-compose и бэкендом) ---
POSTGRES_USER=pcbuilder
POSTGRES_PASSWORD=pcbuilder
POSTGRES_DB=pcbuilder
# Порт на хосте. 5433, чтобы не конфликтовать с локально установленным PostgreSQL
POSTGRES_PORT=5433

DATABASE_URL=postgresql+psycopg://pcbuilder:pcbuilder@localhost:5433/pcbuilder

# --- LLM (необязательно) ---
# Провайдер: none | anthropic | openai
# При none (или пустом ключе) приложение работает без ИИ: разбор запроса по ключевым словам
# и шаблонные объяснения
LLM_PROVIDER=none
LLM_API_KEY=

# Модель. Для anthropic по умолчанию claude-opus-5-5; для openai указывается обязательно
LLM_MODEL=

# Адрес API — только для OpenAI-совместимых сервисов (DeepSeek, локальные Ollama и LM Studio и т.п.).
# Для Ollama: http://localhost:11434/v1, для LM Studio: http://localhost:1234/v1;
# ключ для них — любая непустая строка
LLM_BASE_URL=
# Запросов к LLM в минуту с одного адреса (0 — без ограничения)
AI_RATE_LIMIT_PER_MINUTE=20

# Адреса фронтенда для CORS через запятую (нужно, только если фронтенд на другом адресе)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Логи: уровень и формат (true — JSON, одна запись на строку)
LOG_LEVEL=INFO
LOG_JSON=false

# Порт приложения при запуске всего стека в Docker (docker compose up -d --build)
APP_PORT=8090
