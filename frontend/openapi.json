  "components": {
    "schemas": {
      "AiStatusOut": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          }
        },
        "type": "object",
        "required": [
          "enabled",
          "provider",
          "model"
        ],
        "title": "AiStatusOut"
      },
      "AlternativeOut": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "upgrade",
              "saving"
            ],
            "title": "Kind"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "price_delta": {
            "type": "integer",
            "title": "Price Delta"
          },
          "score_delta_pct": {
            "type": "number",
            "title": "Score Delta Pct"
          },
          "worth_it": {
            "type": "boolean",
            "title": "Worth It"
          },
          "new_part": {
            "$ref": "#/components/schemas/ComponentOut"
          },
          "also_changed": {
            "items": {
              "$ref": "#/components/schemas/ComponentOut"
            },
            "type": "array",
            "title": "Also Changed"
          },
          "part_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Part Ids"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "category",
          "text",
          "price_delta",
          "score_delta_pct",
          "worth_it",
          "new_part",
          "also_changed",
          "part_ids"
        ],
        "title": "AlternativeOut"
      },
      "Category": {
        "type": "string",
        "enum": [
          "cpu",
          "gpu",
          "motherboard",
          "ram",
          "storage",
          "psu",
          "case",
          "cooler"
        ],
        "title": "Category"
      },
      "CheckIn": {
        "properties": {
          "part_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Part Ids"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete",
            "default": false
          },
          "resolution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Resolution"
              },
              {
                "type": "null"
              }
            ],
            "default": "1440p"
          }
        },
        "type": "object",
        "required": [
          "part_ids"
        ],
        "title": "CheckIn"
      },
      "CheckOut": {
        "properties": {
          "is_compatible": {
            "type": "boolean",
            "title": "Is Compatible"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/IssueOut"
            },
            "type": "array",
            "title": "Issues"
          },
          "total_price": {
            "type": "integer",
            "title": "Total Price"
          },
          "estimated_power_w": {
            "type": "integer",
            "title": "Estimated Power W"
          },
          "recommended_psu_w": {
            "type": "integer",
            "title": "Recommended Psu W"
          }
        },
        "type": "object",
        "required": [
          "is_compatible",
          "issues",
          "total_price",
          "estimated_power_w",
          "recommended_psu_w"
        ],
        "title": "CheckOut"
      },
      "ComponentOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "brand": {
            "type": "string",
            "title": "Brand"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "price_rub": {
            "type": "integer",
            "title": "Price Rub"
          },
          "perf_score": {
            "type": "integer",
            "title": "Perf Score"
          },
          "power_w": {
            "type": "integer",
            "title": "Power W"
          },
          "specs": {
            "additionalProperties": true,
            "type": "object",
            "title": "Specs"
          }
        },
        "type": "object",
        "required": [
          "id",
          "category",
          "brand",
          "name",
          "title",
          "price_rub",
          "perf_score",
          "power_w",
          "specs"
        ],
        "title": "ComponentOut"
      },
      "CredentialsIn": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "CredentialsIn"
      },
      "EvaluateIn": {
        "properties": {
          "budget": {
            "type": "integer",
            "maximum": 2000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Budget",
            "description": "Бюджет, ₽"
          },
          "scenario": {
            "$ref": "#/components/schemas/Scenario"
          },
          "resolution": {
            "$ref": "#/components/schemas/Resolution",
            "default": "1440p"
          },
          "platform": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Platform"
              },
              {
                "type": "null"
              }
            ]
          },
          "cpu_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cpu Id"
          },
          "gpu_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gpu Id"
          },
          "part_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Part Ids"
          }
        },
        "type": "object",
        "required": [
          "budget",
          "scenario",
