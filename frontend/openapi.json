{
  "openapi": "3.1.0",
  "info": {
    "title": "Конфигуратор ПК",
    "description": "Подбор сборок ПК под бюджет и сценарий с объяснением выбора",
    "version": "1.0.0"
  },
  "paths": {
    "/api/components": {
      "get": {
        "tags": [
          "Комплектующие"
        ],
        "summary": "List Components",
        "operationId": "list_components_api_components_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Category"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ComponentOut"
                  },
                  "title": "Response List Components Api Components Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/components/options": {
      "post": {
        "tags": [
          "Комплектующие"
        ],
        "summary": "Component Options",
        "description": "Варианты для шага ручной сборки: все детали категории с отметкой совместимости.\n\nСовместимые идут первыми, внутри — по цене. Несовместимые возвращаются с причиной:\nфронтенд по умолчанию их скрывает, но может показать, почему деталь не подходит.",
        "operationId": "component_options_api_components_options_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptionsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/OptionOut"
                  },
                  "type": "array",
                  "title": "Response Component Options Api Components Options Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
