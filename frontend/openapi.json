    "/api/health/ready": {
      "get": {
        "tags": [
          "Служебное"
        ],
        "summary": "Ready",
        "description": "Готов обслуживать запросы (readiness): база отвечает.\n\nСостояние Redis только сообщается: без него лимиты и кэш каталога работают\nв памяти процесса, поэтому недоступный Redis не повод снимать экземпляр с балансировки.",
        "operationId": "ready_api_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
